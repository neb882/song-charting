+def _m7_agreement(a, b, qa, qb, tol):
+    """agreement() with the silent onsets (qa, qb) unable to match; with none silent, agreement() itself."""
+    if not qa.any() and not qb.any():
+        return agreement(a, b, tol)
+    (ta, wa), (tb, wb) = a, b
+    if not len(ta) and not len(tb):
+        return 1.0
+    if not len(ta) or not len(tb):
+        return 0.0
+    used = qb.copy()
+    m = 0
+    for t, w, q in zip(ta, wa, qa):
+        if q:
+            continue
+        lo, hi = np.searchsorted(tb, t - tol), np.searchsorted(tb, t + tol, side="right")
+        ks = [k for k in range(lo, hi) if not used[k] and wb[k] == w]
+        if ks:
+            used[min(ks, key=lambda k: abs(tb[k] - t))] = True
+            m += 1
+    return 2 * m / (len(ta) + len(tb))
