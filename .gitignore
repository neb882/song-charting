# Audio is never committed: the song is the artist's copyrighted recording, and
# stems are large. Each person supplies their own copy locally.
*.mp3
*.ogg
*.opus
*.wav
*.flac
*.m4a
*.mp4
*.webm

# Local working data and environments
work/
stems/
models/
out/
.venv/
venv/
__pycache__/
*.pyc
node_modules/
*.egg-info/
.pytest_cache/

# Evaluation: downloaded reference songs/charts, tool installs, models and runs stay local
eval/data/
eval/.venv/
eval/tools/*/src/
eval/tools/*/src_dl/
eval/tools/*/venv/
eval/tools/*/models/
eval/tools/*/node_modules/
eval/tools/*/runs/
eval/tools/*/test/
eval/tools/*/weights_hf/
eval/tools/*/torch_home/
eval/tools/*/rt/
